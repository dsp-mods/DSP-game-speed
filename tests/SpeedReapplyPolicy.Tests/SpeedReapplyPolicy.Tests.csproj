<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the Unity-free reapply policy in the mod. This project is never
    loaded by the game. It compiles SpeedReapplyPolicy.cs directly, and LangVersion
    7.3 keeps that file compatible with the mod's .NET Framework / Mono build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../SpeedReapplyPolicy.cs" Link="SpeedReapplyPolicy.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
